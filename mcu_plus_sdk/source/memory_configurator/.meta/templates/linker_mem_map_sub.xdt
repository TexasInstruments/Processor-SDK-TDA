% let common = system.getScript("/common");

%%{
function util_function_shared_regions() {
    let coreNames = common.getSysCfgCoreNames();
    let selfCoreName = common.getSelfSysCfgCoreName();
    if (!coreNames || coreNames.length === 0) {
        coreNames = ["main-r5fss0-0", "wkup-r5fss0-0", "c75ss0-0", "c75ss1-0"];
    }

    let all_core_memory_instances = [];
    let regions_shared_with_this_core = [];
    let seen_region_names = new Set();

    for (let core of coreNames) {
        if(core.includes(selfCoreName)) continue;

        let core_module_mpu = common.getModuleForCore("/memory_configurator/memory_region_mpu", core);
        let core_module = common.getModuleForCore("/memory_configurator/memory_region", core);

        if(core_module_mpu !== undefined && core_module_mpu.$instances) {
            all_core_memory_instances.push(core_module_mpu.$instances);
        }
        if(core_module !== undefined && core_module.$instances) {
            all_core_memory_instances.push(core_module.$instances);
        }
    }

    _.each(all_core_memory_instances, (each_core_memory_module) => {
        _.each(each_core_memory_module, (inst) => {
            if(inst.isShared && inst.shared_cores && inst.shared_cores.includes(selfCoreName)) {
                if(!seen_region_names.has(inst.$name)) {
                    regions_shared_with_this_core.push(inst);
                    seen_region_names.add(inst.$name);
                }
            }
        });
    });

    return regions_shared_with_this_core;
}
%%}

MEMORY
{
    % let memory_region_module = system.modules["/memory_configurator/memory_region"];
    % let memory_region_mpu_module = system.modules["/memory_configurator/memory_region_mpu"];
    % let region_module_instances = [];
    % let seen_region_names = new Set();

    % if (memory_region_mpu_module !== undefined) {
    %     region_module_instances = memory_region_mpu_module.$instances;
    % } else if (memory_region_module !== undefined) {
    %     region_module_instances = memory_region_module.$instances;
    % }

    % if (region_module_instances.length > 0) {
    % for (let item of region_module_instances) {
    % if (item.allowOverlap) continue;
    % let attr = ""
    % if (item.attributes.length > 0) {
    %     let orderedAttrs = [];
    %     if (item.attributes.includes("R")) orderedAttrs.push("R");
    %     if (item.attributes.includes("W")) orderedAttrs.push("W");
    %     if (item.attributes.includes("X")) orderedAttrs.push("X");
    %     if (item.attributes.includes("I")) orderedAttrs.push("I");
    %     attr = "( " + orderedAttrs.join("") + " )";
    % }
    % seen_region_names.add(item.$name);
    /* `item.$name` [ size `(item.size / 1024).toFixed(2)` KB ] */
    `item.$name.padEnd(24)` `attr.padEnd(10)` : ORIGIN = 0x`item.auto ? item.autoStartAddress.toString(16).toUpperCase().padStart(8, '0') : item.manualStartAddress.toString(16).toUpperCase().padStart(8, '0')` , LENGTH = 0x`item.size.toString(16).toUpperCase().padStart(8, '0')`
    % }
    % }

    /* For memory Regions not defined in this core but shared by other cores with the current core */
    % let regions_shared_with_this_core = util_function_shared_regions();
    % for (let item of regions_shared_with_this_core) {
    % if (!seen_region_names.has(item.$name) && !item.allowOverlap) {
    % let attr = ""
    % if (item.attributes.length > 0) {
    %     let orderedAttrs = [];
    %     if (item.attributes.includes("R")) orderedAttrs.push("R");
    %     if (item.attributes.includes("W")) orderedAttrs.push("W");
    %     if (item.attributes.includes("X")) orderedAttrs.push("X");
    %     if (item.attributes.includes("I")) orderedAttrs.push("I");
    %     attr = "( " + orderedAttrs.join("") + " )";
    % }
    % let origin = item.auto ? item.autoStartAddress : item.manualStartAddress;
    % if (origin >= 0) {
    /* `item.$name` [ size `(item.size / 1024).toFixed(2)` KB ] */
    `item.$name.padEnd(24)` `attr.padEnd(10)` : ORIGIN = 0x`origin.toString(16).toUpperCase().padStart(8, '0')` , LENGTH = 0x`item.size.toString(16).toUpperCase().padStart(8, '0')`
    % }
    % }
    % }
}