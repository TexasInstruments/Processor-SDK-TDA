%%{

let common = system.getScript("/common");

/*
 * Build a flat map of { regionName -> { origin, size } } by scanning all cores.
 * Uses the same cross-core iteration pattern as app_mem_map.xdt.
 */
function buildRegionMap() {
    let coreNames = common.getSysCfgCoreNames();
    if (!coreNames || coreNames.length === 0) {
        coreNames = ["main-r5fss0-0", "wkup-r5fss0-0", "c75ss0-0", "c75ss1-0"];
    }

    let regionMap = {};

    for (let core of coreNames) {
        let mod = common.getModuleForCore("/memory_configurator/memory_region", core);
        let modMpu = common.getModuleForCore("/memory_configurator/memory_region_mpu", core);
        let modMmu = common.getModuleForCore("/memory_configurator/memory_region_mmu", core);

        let instances = [];
        if (mod !== undefined && mod.$instances) instances = instances.concat(mod.$instances);
        if (modMpu !== undefined && modMpu.$instances) instances = instances.concat(modMpu.$instances);
        if (modMmu !== undefined && modMmu.$instances) instances = instances.concat(modMmu.$instances);

        for (let inst of instances) {
            if (regionMap[inst.$name] !== undefined) continue;
            let origin = inst.auto ? inst.autoStartAddress : inst.manualStartAddress;
            let size = (modMpu !== undefined && modMpu.$instances && modMpu.$instances.includes(inst))
                ? Math.pow(2, inst.size)
                : inst.size;
            regionMap[inst.$name] = { origin, size };
        }
    }
    return regionMap;
}

const REGION_MAP = buildRegionMap();

/* Lookup helpers */
function getOrigin(regionName) {
    return REGION_MAP[regionName] !== undefined ? REGION_MAP[regionName].origin : -1;
}
function getSize(regionName) {
    return REGION_MAP[regionName] !== undefined ? REGION_MAP[regionName].size : -1;
}

/* Lookup table: region $name -> [dtsLabel, dtsNode]
 *
 * IMPORTANT: The region $names used as keys below are a fixed interface between
 * SysConfig and the Linux kernel DTSI. Do NOT rename these regions in SysConfig
 * without also updating this lookup table.
 *
 * Fixed region names:
 *   DDR_MCU1_0_IPC, DDR_MCU1_0_RESOURCE_TABLE, DDR_MCU1_0_IPC_TRACE, DDR_MCU1_0
 *   DDR_MCU2_0_IPC, DDR_MCU2_0_RESOURCE_TABLE, DDR_MCU2_0_IPC_TRACE, DDR_MCU2_0
 *   DDR_C7x_1_IPC, DDR_C7x_1_RESOURCE_TABLE, DDR_C7x_1_IPC_TRACE,
 *     DDR_C7x_1_BOOT, DDR_C7x_1_VECS, DDR_C7x_1_SECURE_VECS, DDR_C7x_1
 *   DDR_C7x_2_IPC, DDR_C7x_2_RESOURCE_TABLE, DDR_C7x_2_IPC_TRACE,
 *     DDR_C7x_2_BOOT, DDR_C7x_2_VECS, DDR_C7x_2_SECURE_VECS, DDR_C7x_2
 *   IPC_VRING_MEM
 *   APP_LOG_MEM, TIOVX_OBJ_DESC_MEM, APP_FILEIO_MEM, TIOVX_LOG_RT_MEM
 *   DDR_MCU1_0_LOCAL_HEAP, DDR_MCU2_0_LOCAL_HEAP, DDR_MCU2_0_VISS_CONFIG_HEAP
 *   INTERCORE_ETH_DESC_MEM, INTERCORE_ETH_DATA_MEM
 */
const DTS_LABEL_MAP = {
    "DDR_MCU1_0_IPC":         "vision_apps_mcu_r5fss0_core0_dma_memory_region",
    "DDR_MCU2_0_IPC":         "vision_apps_main_r5fss0_core0_dma_memory_region",
    "DDR_C7x_1_IPC":          "vision_apps_c71_0_dma_memory_region",
    "DDR_C7x_2_IPC":          "vision_apps_c71_1_dma_memory_region",
    "IPC_VRING_MEM":          "vision_apps_rtos_ipc_memory_region",
    "INTERCORE_ETH_DESC_MEM": "vision_apps_main_r5fss0_core0_shared_memory_queue_region",
    "INTERCORE_ETH_DATA_MEM": "vision_apps_main_r5fss0_core0_shared_memory_bufpool_region",
};

const DTS_NODE_MAP = {
    "DDR_MCU1_0_IPC":         "vision-apps-r5f-dma-memory",
    "DDR_MCU2_0_IPC":         "vision-apps-r5f-dma-memory",
    "DDR_C7x_1_IPC":          "vision-apps-c71-dma-memory",
    "DDR_C7x_2_IPC":          "vision-apps-c71_1-dma-memory",
    "IPC_VRING_MEM":          "vision-apps-rtos-ipc-memory-region",
    "INTERCORE_ETH_DESC_MEM": "vision-apps-r5f-virtual-eth-queues",
    "INTERCORE_ETH_DATA_MEM": "vision-apps-r5f-virtual-eth-buffers",
};

/* Concat: span from min(origin) to max(origin+size) across a list of region names */
function concatRegions(regionNames) {
    let start = Infinity;
    let end   = 0;
    for (let name of regionNames) {
        let o = getOrigin(name);
        let s = getSize(name);
        if (o < start)     start = o;
        if (o + s > end)   end   = o + s;
    }
    return { origin: start, size: end - start };
}

function hex8(n) {
    return (n >>> 0).toString(16).padStart(8, "0");
}

function splitAddr(addr) {
    let lo = addr & 0xFFFFFFFF;
    let hi = Math.floor(addr / 0x100000000) & 0xFF;
    return { hi, lo };
}

/*
 * Resolve the physical address of DDR_SHARED_MEM dynamically.
 *
 * DDR_SHARED_MEM has a virtual address (manualStartAddress = 0xC0000000).
 * Its physical address lives in either:
 *   - mmu_armv8 instances (C7x cores):  vAddr == sharedVAddr  ->  pAddr
 *   - addr_translate instances (R5F cores): localAddr == sharedVAddr  ->  systemAddr
 *
 * We search all cores for either module and return the first matching physical address.
 */
function resolveSharedMemPhysical() {
    let sharedVAddr = getOrigin("DDR_SHARED_MEM");
    let sharedSize  = getSize("DDR_SHARED_MEM");
    if (sharedVAddr === -1) return { phys: -1, size: -1 };

    let coreNames = common.getSysCfgCoreNames();
    if (!coreNames || coreNames.length === 0) {
        coreNames = ["main-r5fss0-0", "wkup-r5fss0-0", "c75ss0-0", "c75ss1-0"];
    }

    for (let core of coreNames) {
        /* C7x: mmu_armv8 module */
        let mmuMod = common.getModuleForCore("/kernel/dpl/mmu_armv8", core);
        if (mmuMod !== undefined && mmuMod.$instances) {
            for (let inst of mmuMod.$instances) {
                if (inst.vAddr !== undefined && inst.vAddr === sharedVAddr) {
                    return { phys: inst.pAddr, size: sharedSize };
                }
            }
        }
        /* R5F: addr_translate module. Instances spawned by Automate RAT keep
         * their address in localAddr_mr (isAutomated). */
        let atMod = common.getModuleForCore("/kernel/dpl/addr_translate", core);
        if (atMod !== undefined && atMod.$instances) {
            for (let inst of atMod.$instances) {
                let atLocal = (inst.isAutomated === true && inst.localAddr_mr !== undefined) ? inst.localAddr_mr : inst.localAddr;
                if (atLocal !== undefined && atLocal === sharedVAddr) {
                    return { phys: inst.systemAddr, size: sharedSize };
                }
            }
        }
    }
    return { phys: -1, size: -1 };
}

/*
 * Build the list of DTSI nodes.
 * Each entry: { label, node, origin, size, split, compatible, nomap, originTag }
 * Defaults (applied at emit time): compatible="shared-dma-pool", nomap=true,
 *   originTag=true, split=false
 */
let nodes  = [];
let errors = [];

const sharedMem = resolveSharedMemPhysical();
if (sharedMem.phys === -1) {
    errors.push("DDR_SHARED_MEM physical address not found — no MMU/addr_translate entry maps 0x" +
                getOrigin("DDR_SHARED_MEM").toString(16));
}

/* High-DDR physical base for C7x heaps — read from the first
 * C7x mmu_armv8 entry whose pAddr >= 0x800000000 and is not the shared region. */
function resolveC7xHighPhysical() {
    let coreNames = common.getSysCfgCoreNames();
    if (!coreNames || coreNames.length === 0) {
        coreNames = ["c75ss0-0", "c75ss1-0"];
    }
    /* Sum all C7x high-DDR regions (DDR_C7X_1_LOCAL_HEAP_NON_CACHEABLE through
     * DDR_C7X_2_SCRATCH) using REGION_MAP — these are the *virtual* high addresses.
     * The physical base is constant at 0x880000000 per the SoC memory map;
     * read it from the mmu_armv8 entry whose pAddr is in that range. */
    for (let core of coreNames) {
        let mmuMod = common.getModuleForCore("/kernel/dpl/mmu_armv8", core);
        if (mmuMod !== undefined && mmuMod.$instances) {
            for (let inst of mmuMod.$instances) {
                if (inst.pAddr !== undefined &&
                    inst.pAddr >= 0x800000000 &&
                    inst.pAddr !== sharedMem.phys) {
                    /* Found the first C7x high-DDR physical mapping.
                     * Total size spans all C7x high regions: calculate from REGION_MAP. */
                    let hiRegions = [
                        "DDR_C7X_1_LOCAL_HEAP_NON_CACHEABLE", "DDR_C7X_1_SCRATCH_NON_CACHEABLE",
                        "DDR_C7X_1_LOCAL_HEAP",               "DDR_C7X_1_SCRATCH",
                        "DDR_C7X_2_LOCAL_HEAP_NON_CACHEABLE", "DDR_C7X_2_SCRATCH_NON_CACHEABLE",
                        "DDR_C7X_2_LOCAL_HEAP",               "DDR_C7X_2_SCRATCH",
                    ];
                    let totalSize = 0;
                    for (let name of hiRegions) {
                        let s = getSize(name);
                        if (s !== -1) totalSize += s;
                    }
                    return { phys: inst.pAddr, size: totalSize };
                }
            }
        }
    }
    return { phys: 0x880000000, size: 0x20000000 }; /* fallback to known constant */
}

const c7xHigh = resolveC7xHighPhysical();

function addDirect(label, node, regionName) {
    let origin = getOrigin(regionName);
    let size   = getSize(regionName);
    if (origin === -1 || size === -1) {
        errors.push("region '" + regionName + "' not found — check region name in SysConfig");
        return;
    }
    nodes.push({ label, node, origin, size });
}

function addConcat(label, node, regionNames) {
    for (let name of regionNames) {
        if (getOrigin(name) === -1 || getSize(name) === -1) {
            errors.push("region '" + name + "' not found — check region name in SysConfig");
            return;
        }
    }
    let span = concatRegions(regionNames);
    nodes.push({ label, node, origin: span.origin, size: span.size });
}

/* ── Direct IPC regions (one per core) ── */
addDirect(DTS_LABEL_MAP["DDR_MCU1_0_IPC"], DTS_NODE_MAP["DDR_MCU1_0_IPC"], "DDR_MCU1_0_IPC");
addDirect(DTS_LABEL_MAP["DDR_MCU2_0_IPC"], DTS_NODE_MAP["DDR_MCU2_0_IPC"], "DDR_MCU2_0_IPC");
addDirect(DTS_LABEL_MAP["DDR_C7x_1_IPC"],  DTS_NODE_MAP["DDR_C7x_1_IPC"],  "DDR_C7x_1_IPC");
addDirect(DTS_LABEL_MAP["DDR_C7x_2_IPC"],  DTS_NODE_MAP["DDR_C7x_2_IPC"],  "DDR_C7x_2_IPC");

/* ── Concat: MCU1_0 main DDR (resource_table + ipc_trace + code/data) ── */
addConcat("vision_apps_mcu_r5fss0_core0_memory_region", "vision-apps-r5f-memory",
    ["DDR_MCU1_0_RESOURCE_TABLE", "DDR_MCU1_0_IPC_TRACE", "DDR_MCU1_0"]);

/* ── Concat: MCU2_0 main DDR (resource_table + ipc_trace + code/data) ── */
addConcat("vision_apps_main_r5fss0_core0_memory_region", "vision-apps-r5f-memory",
    ["DDR_MCU2_0_RESOURCE_TABLE", "DDR_MCU2_0_IPC_TRACE", "DDR_MCU2_0"]);

/* ── Direct: IPC vring shared across all cores ── */
addDirect(DTS_LABEL_MAP["IPC_VRING_MEM"], DTS_NODE_MAP["IPC_VRING_MEM"], "IPC_VRING_MEM");

/* ── Concat: Vision Apps shared DDR (log + obj_desc + fileio + log_rt) ── */
/* Per-host object descriptor slices replace the single TIOVX_OBJ_DESC_MEM region when they are defined */
addConcat("vision_apps_memory_region", "vision-apps-dma-memory",
    ["APP_LOG_MEM"].concat(
        (getOrigin("TIOVX_OBJ_DESC_MEM") === -1 && getOrigin("TIOVX_OBJ_DESC_MEM_HOST0") !== -1)
            ? ["TIOVX_OBJ_DESC_MEM_HOST0", "TIOVX_OBJ_DESC_MEM_HOST1", "TIOVX_OBJ_DESC_MEM_HOST2"]
            : ["TIOVX_OBJ_DESC_MEM"],
        ["APP_FILEIO_MEM", "TIOVX_LOG_RT_MEM"]));

/* ── Concat: C7x_1 main DDR ── */
addConcat("vision_apps_c71_0_memory_region", "vision-apps-c71_0-memory",
    ["DDR_C7x_1_RESOURCE_TABLE", "DDR_C7x_1_BOOT", "DDR_C7x_1_VECS",
     "DDR_C7x_1_SECURE_VECS", "DDR_C7x_1"]);

/* ── Concat: C7x_2 main DDR ── */
addConcat("vision_apps_c71_1_memory_region", "vision-apps-c71_1-memory",
    ["DDR_C7x_2_RESOURCE_TABLE", "DDR_C7x_2_BOOT", "DDR_C7x_2_VECS",
     "DDR_C7x_2_SECURE_VECS", "DDR_C7x_2"]);

/* ── Concat: core heaps lo (MCU1_0 + MCU2_0 local heaps) ── */
addConcat("vision_apps_core_heaps_lo", "vision-apps-core-heap-memory-lo",
    ["DDR_MCU1_0_LOCAL_HEAP", "DDR_MCU2_0_LOCAL_HEAP", "DDR_MCU2_0_VISS_CONFIG_HEAP"]);

/* ── Direct: Ethernet descriptor and data regions ── */
addDirect(DTS_LABEL_MAP["INTERCORE_ETH_DESC_MEM"], DTS_NODE_MAP["INTERCORE_ETH_DESC_MEM"],
          "INTERCORE_ETH_DESC_MEM");
addDirect(DTS_LABEL_MAP["INTERCORE_ETH_DATA_MEM"], DTS_NODE_MAP["INTERCORE_ETH_DATA_MEM"],
          "INTERCORE_ETH_DATA_MEM");

/* ── C7x high DDR (40-bit physical address, splitOrigin) ── */
if (c7xHigh.phys !== -1) {
    nodes.push({ label: "c7x_ddr_heaps_hi", node: "c7x-ddr-heaps-hi",
                 origin: c7xHigh.phys, size: c7xHigh.size, split: true });
}

/* ── Shared DMA-buf carveout (40-bit physical, no no-map, no @addr suffix) ── */
if (sharedMem.phys !== -1) {
    nodes.push({ label: "vision_apps_shared_region", node: "vision_apps_shared-memories",
                 origin: sharedMem.phys, size: sharedMem.size,
                 split: true, compatible: "dma-heap-carveout", nomap: false, originTag: false });
}

/* Sort all nodes by origin address ascending */
nodes.sort((a, b) => a.origin - b.origin);

%%}

% if (errors.length > 0) {
  /* !! DTSI GENERATION ERRORS - OUTPUT IS INCOMPLETE !!
% for (let e of errors) {
   * ERROR: `e`
% }
   * Fix: ensure all required region names exist in SysConfig and match the
   * lookup table in linux_rtos_memory_map.xdt
   */
% }
% for (let n of nodes) {
%   let compatible = n.compatible !== undefined ? n.compatible : "shared-dma-pool";
%   let nomap      = n.nomap      !== undefined ? n.nomap      : true;
%   let originTag  = n.originTag  !== undefined ? n.originTag  : true;
%   let split = n.split !== undefined ? n.split : false;
%
%   let nodeHeader;
%   if (originTag) {
%       if (split) {
%           let p = splitAddr(n.origin);
%           nodeHeader = n.label + ": " + n.node + "@" + (p.hi.toString(16) + hex8(p.lo)).replace(/^0+/, "") + " {";
%       } else {
%           nodeHeader = n.label + ": " + n.node + "@" + hex8(n.origin) + " {";
%       }
%   } else {
%       nodeHeader = n.label + ": " + n.node + " {";
%   }
%
%   let regLine;
%   if (split) {
%       let p = splitAddr(n.origin);
%       regLine = "reg = <0x" + p.hi.toString(16).padStart(2, "0") + " 0x" + hex8(p.lo) + " 0x00 0x" + hex8(n.size) + ">;";
%   } else {
%       regLine = "reg = <0x00 0x" + hex8(n.origin) + " 0x00 0x" + hex8(n.size) + ">;";
%   }
	`nodeHeader`
		compatible = "`compatible`";
		`regLine`
% if (nomap) {
		no-map;
% }
	};
% }