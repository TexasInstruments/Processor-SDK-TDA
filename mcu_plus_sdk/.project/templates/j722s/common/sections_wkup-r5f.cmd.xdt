%%{
    let options = args.options;

    let stackSize = 0x8000;
    let heapSize =  0x10000;
    let irqStackSize = 0x1000;
    let svcStackSize = 0x0100;
    let fiqStackSize = 0x0100;
    let abortStackSize = 0x0100;
    let undefinedStackSize = 0x0100;
    let useFlash = false;
    let globalScratchBuf = false;
    let globalScratchBufSize = 0x2000000;

    if(options && options.stackSize)         stackSize = options.stackSize;
    if(options && options.heapSize)          heapSize = options.heapSize;
    if(options && options.irqStackSize)      irqStackSize = options.irqStackSize;
    if(options && options.fiqStackSize)      fiqStackSize = options.fiqStackSize;
    if(options && options.svcStackSize)      svcStackSize = options.svcStackSize;
    if(options && options.abortStackSize)    abortStackSize = options.abortStackSize;
    if(options && options.undefinedStackSize) undefinedStackSize = options.undefinedStackSize;
    if(options && options.isXip)             useFlash = true;
    if(options && options.globalScratchBuf) {
        globalScratchBuf = options.globalScratchBuf;
        if(options.globalScratchBufSize) globalScratchBufSize = options.globalScratchBufSize;
    }
%%}

--retain="*(.bootCode)";
--retain="*(.startupCode)";
--retain="*(.startupData)";
--retain="*(.irqStack)";
--retain="*(.fiqStack)";
--retain="*(.abortStack)";
--retain="*(.undefinedstack)";
--retain="*(.svcStack)";
--fill_value=0
--stack_size=0x`stackSize.toString(16).toUpperCase()`
--heap_size=0x`heapSize.toString(16).toUpperCase()`
--entry_point=_self_reset_start

__IRQ_STACK_SIZE = 0x`irqStackSize.toString(16).toUpperCase()`;
__FIQ_STACK_SIZE = 0x0`fiqStackSize.toString(16).toUpperCase()`;
__SVC_STACK_SIZE = 0x0`svcStackSize.toString(16).toUpperCase()`;
__ABORT_STACK_SIZE = 0x0`abortStackSize.toString(16).toUpperCase()`;
__UNDEFINED_STACK_SIZE = 0x0`undefinedStackSize.toString(16).toUpperCase()`;

SECTIONS
{
    .vectors            : {} palign(8) > DDR
    .bootCode           : align = 8, load = R5F_TCMB, run = R5F_TCMA
    .startupCode        : align = 8, load = R5F_TCMB, run = R5F_TCMA
    .startupData        : align = 8, load = R5F_TCMB, run = R5F_TCMA, type = NOINIT

    GROUP {
        .text.hwi: palign(8)
        .text.cache: palign(8)
        .text.mpu: palign(8)
        .text.boot: palign(8)
        .text:abort: palign(8)
    } load = R5F_TCMB, run = R5F_TCMA

    % if(args.project.ipcVringRTOS === true){
    .bss.ipc_vring_mem (NOLOAD) : {} > DDR_IPC_VRING_RTOS
    % }
    % if(args.project.isLinuxInSystem === true){
    GROUP {
        .resource_table: {} palign(1024)
    } > DDR_IPC_RESOURCE_TABLE_LINUX
    .bss.debug_mem_trace_buf : {} palign(128) > DDR_IPC_TRACE_LINUX
    % }

    % if(useFlash === true) {
    .text   : {} palign(8) > FLASH
    .const  : {} palign(8) > FLASH
    .rodata : {} palign(8) > FLASH
    % } else {
    .text   : {} palign(8) > DDR
    .const  : {} palign(8) > DDR
    .rodata : {} palign(8) > DDR
    % }
    .cinit         : {} palign(8)   > DDR
    .far           : {} align(4)    > DDR
    .data          : {} palign(128) > DDR
    .sysmem        : {}             > DDR
    .data_buffer   : {} palign(128) > DDR
    .boardcfg_data : {} align(4)    > DDR

    GROUP {
        .bss: {} palign(4)
        RUN_START(__BSS_START)
        RUN_END(__BSS_END)
    } > DDR

    .benchmark_buffer (NOLOAD) {} ALIGN(8) > DDR
    .stack : {} align(4) > DDR (HIGH)

    GROUP {
        .irqstack: {. = . + __IRQ_STACK_SIZE;} align(4)
        RUN_START(__IRQ_STACK_START)
        RUN_END(__IRQ_STACK_END)
        .fiqstack: {. = . + __FIQ_STACK_SIZE;} align(4)
        RUN_START(__FIQ_STACK_START)
        RUN_END(__FIQ_STACK_END)
        .svcstack: {. = . + __SVC_STACK_SIZE;} align(4)
        RUN_START(__SVC_STACK_START)
        RUN_END(__SVC_STACK_END)
        .abortstack: {. = . + __ABORT_STACK_SIZE;} align(4)
        RUN_START(__ABORT_STACK_START)
        RUN_END(__ABORT_STACK_END)
        .undefinedstack: {. = . + __UNDEFINED_STACK_SIZE;} align(4)
        RUN_START(__UNDEFINED_STACK_START)
        RUN_END(__UNDEFINED_STACK_END)
    } > DDR (HIGH)

    GROUP {
        .ARM.exidx:  {} palign(8)
        .init_array: {} palign(8)
        .fini_array: {} palign(8)
    } > DDR

    % if(globalScratchBuf == true) {
    .globalScratchBuffer (NOLOAD) : {} > DDR
    % }
}
