  % let common = system.getScript("/common");

  %%{
  function util_format_size(bytes) {
      const KB = 1024;
      const MB = KB * KB;
      const GB = KB * MB;

      if (bytes > GB) {
          return (bytes / GB).toFixed(2) + ' GB';
      } else if (bytes > MB) {
          return (bytes / MB).toFixed(2) + ' MB';
      } else if (bytes > KB) {
          return (bytes / KB).toFixed(2) + ' KB';
      } else {
          return bytes + ' B';
      }
  }

  function util_get_mmu_physical_address_from_all_cores(vAddr, size, ownerCore) {
      // Search the owning core first (virtual addresses can repeat across
      // cores with different physical mappings), then any other core (shared regions)
      let coreNames = common.getSysCfgCoreNames();
      if (!coreNames || coreNames.length === 0) {
          const device = system.deviceData.device;
          if (device === "J721S2_TDA4VE_TDA4AL_TDA4VL_AM68x" || device === "J721S2") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","c71ss0-0","c71ss1-0"];
          } else if (device === "J721E_DRA829_TDA4VM_AM752x" || device === "J721E") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","c66ss0-0","c66ss1-0","c71ss0-0"];
          } else if (device === "J742S2") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","r5fss2-0","r5fss2-1","c71ss0-0","c71ss1-0","c71ss2-0"];
          } else if (device === "J784S4_TDA4AP_TDA4VP_TDA4AH_TDA4VH_AM69x" || device === "J784S4") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","r5fss2-0","r5fss2-1","c71ss0-0","c71ss1-0","c71ss2-0","c71ss3-0"];
          } else {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","c66ss0-0","c66ss1-0","c71ss0-0"];
          }
      }

      if (ownerCore) {
          coreNames = [ownerCore].concat(coreNames.filter(c => c !== ownerCore));
      }

      for (let core of coreNames) {
          /* MCU+ SDK MMU module (vAddr/pAddr) and vision_apps mmu_cfg module.
           * memory_region_mmu itself has no address fields; its address data
           * lives in the spawned mmu_cfg children, which are listed under
           * /memory_configurator/mmu_cfg. Instances spawned by Automate MMU
           * keep their addresses in vAddr_mr/pAddr_mr (isAutomated). */
          let mmu_modules = [
              common.getModuleForCore("/kernel/dpl/mmu_armv8", core),
              common.getModuleForCore("/memory_configurator/mmu_cfg", core),
          ];

          for (let mmu_module of mmu_modules) {
              if (mmu_module === undefined || !mmu_module.$instances) {
                  continue;
              }

              for (let mmu_inst of mmu_module.$instances) {
                  let mmu_v = mmu_inst.isAutomated ? mmu_inst.vAddr_mr : mmu_inst.vAddr;
                  let mmu_p = mmu_inst.isAutomated ? mmu_inst.pAddr_mr : mmu_inst.pAddr;
                  if (mmu_v !== undefined && mmu_p !== undefined && mmu_inst.size !== undefined) {
                      let mmu_end = mmu_v + mmu_inst.size;

                      if (vAddr >= mmu_v && vAddr < mmu_end) {
                          let offset = vAddr - mmu_v;
                          return mmu_p + offset;
                      }
                  }
              }
          }

          /* Check vision_apps RAT (rat_cfg) module: localAddr -> systemAddr.
           * size is stored as a power-of-2 exponent. Instances spawned by
           * Automate RAT keep their address in localAddr_mr (isAutomated). */
          let rat_module = common.getModuleForCore("/memory_configurator/rat_cfg", core);
          if (rat_module !== undefined && rat_module.$instances) {
              for (let rat_inst of rat_module.$instances) {
                  let rat_local = rat_inst.isAutomated ? rat_inst.localAddr_mr : rat_inst.localAddr;
                  if (rat_local !== undefined && rat_inst.systemAddr !== undefined && rat_inst.size !== undefined) {
                      let rat_size = Math.pow(2, rat_inst.size);
                      let rat_end  = rat_local + rat_size;
                      if (vAddr >= rat_local && vAddr < rat_end) {
                          let offset = vAddr - rat_local;
                          return rat_inst.systemAddr + offset;
                      }
                  }
              }
          }
      }
      return null;
  }

  function util_get_all_regions() {
      let coreNames = common.getSysCfgCoreNames();
      if (!coreNames || coreNames.length === 0) {
          const device = system.deviceData.device;
          if (device === "J721S2_TDA4VE_TDA4AL_TDA4VL_AM68x" || device === "J721S2") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","c71ss0-0","c71ss1-0"];
          } else if (device === "J721E_DRA829_TDA4VM_AM752x" || device === "J721E") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","c66ss0-0","c66ss1-0","c71ss0-0"];
          } else if (device === "J742S2") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","r5fss2-0","r5fss2-1","c71ss0-0","c71ss1-0","c71ss2-0"];
          } else if (device === "J784S4_TDA4AP_TDA4VP_TDA4AH_TDA4VH_AM69x" || device === "J784S4") {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","r5fss2-0","r5fss2-1","c71ss0-0","c71ss1-0","c71ss2-0","c71ss3-0"];
          } else {
              coreNames = ["mcu-r5fss0-0","r5fss0-0","r5fss0-1","r5fss1-0","r5fss1-1","c66ss0-0","c66ss1-0","c71ss0-0"];
          }
      }

      let all_regions = [];
      let region_to_core_map = {};
      let seen_region_names = new Set();

      for (let core of coreNames) {
          let core_module = common.getModuleForCore("/memory_configurator/memory_region", core);

          if (core_module !== undefined && core_module.$instances) {
              for (let inst of core_module.$instances) {
                  if (!seen_region_names.has(inst.$name)) {
                      all_regions.push(inst);
                      region_to_core_map[inst.$name] = core;
                      seen_region_names.add(inst.$name);
                  }
              }
          }
      }

      all_regions.__region_to_core_map = region_to_core_map;
      return all_regions;
  }

  function sortByAddress(a, b) {
      let addrA = a.auto ? a.autoStartAddress : a.manualStartAddress;
      let addrB = b.auto ? b.autoStartAddress : b.manualStartAddress;
      return addrA - addrB;
  }

  /*
   * Builds a list of DTS span entries dynamically — no hardcoded region names.
   *
   * For each core's IPC region (name ending "_IPC"), derives PREFIX by stripping
   * "_IPC". Finds the "main" code region named exactly PREFIX. The DTS span runs
   * from the lowest address of all PREFIX_* sub-regions (excluding _IPC itself)
   * up to the end of the main region. This naturally excludes heaps and scratch
   * regions whose addresses fall beyond the main code region.
   *
   * Returns: array of { name, addr, size } sorted by address.
   */
  function util_get_dts_spans(all_regions, region_to_core_map) {
      let groupedByCore = {};
      for (let inst of all_regions) {
          let core = region_to_core_map[inst.$name];
          if (!core) continue;
          if (!groupedByCore[core]) groupedByCore[core] = [];
          groupedByCore[core].push(inst);
      }

      let dts_spans = [];
      for (let core of Object.keys(groupedByCore)) {
          let coreRegions = groupedByCore[core];
          let ipcRegion = coreRegions.find(r => r.$name.endsWith("_IPC"));
          if (!ipcRegion) continue;

          let prefix = ipcRegion.$name.replace(/_IPC$/, "");

          /* Main code region is named exactly PREFIX */
          let mainRegion = coreRegions.find(r => r.$name === prefix);
          if (!mainRegion) continue;

          let mainAddr = mainRegion.auto ? mainRegion.autoStartAddress : mainRegion.manualStartAddress;
          let dtsEnd   = mainAddr + mainRegion.size;

          /* Sub-regions: start with PREFIX_ and are not the IPC region */
          let subRegions = coreRegions.filter(r =>
              r !== ipcRegion && r.$name !== prefix && r.$name.startsWith(prefix + "_")
          );

          let dtsStart = mainAddr;
          for (let r of subRegions) {
              let a = r.auto ? r.autoStartAddress : r.manualStartAddress;
              if (a < dtsEnd && a < dtsStart) dtsStart = a;
          }

          dts_spans.push({ name: prefix + "_DTS", addr: dtsStart, size: dtsEnd - dtsStart });
      }

      dts_spans.sort((a, b) => a.addr - b.addr);
      return dts_spans;
  }
  %%}

#ifndef APP_MEM_MAP_H
#define APP_MEM_MAP_H

  % let all_regions = util_get_all_regions();
  % let region_to_core_map = all_regions.__region_to_core_map;
  % all_regions.sort(sortByAddress);

  % for (let item of all_regions) {
  % if (item.$name.startsWith("R5F_TCM")) continue;
  % let sizeStr = util_format_size(item.size);
  % let addr = item.auto ? item.autoStartAddress : item.manualStartAddress;
/* `item.$name` [ size `sizeStr` ] */
#define `item.$name`_ADDR (0x`addr.toString(16).toUpperCase().padStart(8, '0')`u)
#define `item.$name`_SIZE (0x`item.size.toString(16).toUpperCase().padStart(8, '0')`u)

  % // Check if this region has a physical address mapping (from any core's MMU)
  % let physAddr = util_get_mmu_physical_address_from_all_cores(addr, item.size, region_to_core_map[item.$name]);
  % // Shared memory always gets a _PHYS symbol, even when identity mapped (e.g. j721e), as host code consumes it unconditionally
  % let isSharedMemRegion = item.$name === "DDR_SHARED_MEM" || /^DDR_SHARED_MEM_HOST\d+$/.test(item.$name);
  % if (physAddr !== null && (physAddr !== addr || isSharedMemRegion)) {
/* `item.$name`_PHYS [ size `sizeStr` ] */
#define `item.$name`_PHYS_ADDR (0x`physAddr.toString(16).toUpperCase().padStart(8, '0')`u)
#define `item.$name`_PHYS_SIZE (0x`item.size.toString(16).toUpperCase().padStart(8, '0')`u)

  % }
  % }

  % let dts_spans = util_get_dts_spans(all_regions, region_to_core_map);
  % for (let dts of dts_spans) {
  % let dtsSizeStr = util_format_size(dts.size);
/* `dts.name` [ size `dtsSizeStr` ] */
#define `dts.name`_ADDR (0x`dts.addr.toString(16).toUpperCase().padStart(8, '0')`u)
#define `dts.name`_SIZE (0x`dts.size.toString(16).toUpperCase().padStart(8, '0')`u)

  % }

#define DDR_64BIT_BASE_VADDR (0x100000000u)
#define DDR_64BIT_BASE_PADDR (0x880000000u)

#endif /* APP_MEM_MAP_H */
