  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu6/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu7/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/enable_error_logging" value="false"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/ignore_memory_transaction_failure" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/variant" value="OCX_A720AE"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DDR_0.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/tispl.bin,0x00080000,,image,} {$(PSDK_OUT)/u-boot.img,0x01000000,,image,} {$(PSDK_OUT)/Image,0x02000000,,image,} {$(PSDK_OUT)/k3-tda54-vdk.dtb,0x08000000,,image,} {$(PSDK_OUT)/k3-tda54-vdk-vision-apps.dtbo,0x09000000,,image,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DWC_IPs.DDR_SS_0.SNPS_SS.LPDDR_0.#SCML_PROPERTIES#ENABLE_DFI_INIT_COMPLETE" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DWC_IPs.DDR_SS_1.SNPS_SS.LPDDR_0.#SCML_PROPERTIES#ENABLE_DFI_INIT_COMPLETE" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DWC_IPs.DDR_SS_2.SNPS_SS.LPDDR_0.#SCML_PROPERTIES#ENABLE_DFI_INIT_COMPLETE" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DWC_IPs.DDR_SS_3.SNPS_SS.LPDDR_0.#SCML_PROPERTIES#ENABLE_DFI_INIT_COMPLETE" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Periphs.VP9D.#EXTRA_PROPERTIES#/config/root_path" value="$(vpconfigDir)"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Periphs.virtio_net_tlm_0.#SCML_PROPERTIES#SLIRP_PORT_FORWARDING" value="8022=22"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_CardCapacity_ReducedConfig" value="_32G"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_SD_SWITCH_ACMD_WIDE_WIDTH_MSB_ORDER" value="3"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD8_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_CardCapacity_ReducedConfig" value="_32G"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_CardType" value="SDv3.00"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_SD_CSD_CSD_STRUCTURE" value="1"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/rootfs-img.wic,,,image,}"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Designware_IP.VIRTIO_GPU.virtio_gpu_tlm_0.#SCML_PROPERTIES#vram_size" value="0x0"/>
  <monitorSets name="Default" path="${vpconfigDir}/Default.monitors" chartDisplayScript="">
