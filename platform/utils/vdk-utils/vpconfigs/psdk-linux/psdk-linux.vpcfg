<?xml version="1.0" encoding="ASCII"?>
<com.synopsys.vp.base.vpcfg.core:Configuration xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:com.synopsys.vp.base.vpcfg.core="com.synopsys.vp.base.vpcfg.core.model" simDir="" simExe="" simArgs="--cwr_wait --snps_vp_profile" simulationStartupScript="" unevaledParamFileVDKC="" unevaledParamFilePCT="" description="This VP Configuration boots TI Linux BSP (Board Support Package). This constitutes of U-Boot tiU26.01, Kernel tiL6.18, Rootfs from Yocto Wrynose. This configuration works with R10.1.0 TDA5_System FixedVDK release" vpScript="${lib:SNPS_ARMSP_SCRIPTS_LIBRARY}/armsp/vpx_shared/vpscript.py" clearVPScriptInterp="false" comment="gen_tool_VDK-C" simulationScriptReferences="STARTUP_9c8ed29d-1bc6-4f0f-bc3e-23e1d2844987&#xA;BEGIN_OF_SIMULATION_a067d63e-03b0-43ad-a76d-efafa55682dc&#xA;BEGIN_OF_SIMULATION_bf80b3ed-d5e4-48a3-920d-ce5396df303e&#xA;BEGIN_OF_SIMULATION_ef1ac1d1-23ec-4c0a-a732-d9c92daf89a1&#xA;BEGIN_OF_SIMULATION_060b38fb-9217-4334-9148-4b5707e916d1&#xA;">
  <environmentVariables name="FASTSIM_FASTRAM" defaultValue="0"/>
  <environmentVariables name="IMG_GPU_LIB_PATH" defaultValue="$(vpconfigDir)/../shared/devices/gpu_72.3.408.1039.so"/>
  <environmentVariables name="LINUX_RPROC_BOOT" defaultValue="1"/>
  <environmentVariables name="BOOTMODE" defaultValue="SD"/>
  <debugInfo traceSimOutput="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#BACKEND_LIBRARY" value="$(PSDK_OUT)/libtivision_apps.so"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#CPUID_BITMASK" value="0x3C2"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#ENABLE_C7xHostEmulation" value="false"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#SYMBOL_FILE" value="$(PSDK_OUT)/vx_app_rtos_linux_c7x_1.out"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.DM_MSRAM.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/u-boot-m55-spl.bin,0x80000,,image,} {$(PSDK_OUT)/lpddr5-firmware.bin,0x0,,image,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.M55_SS.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/u-boot-m55-spl,,,symbols,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.M55_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/INITNSVTOR" value="0x23e80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.M55_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/variant" value="AFM_M55"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.MCU_PADCFG_0.#EXTRA_PROPERTIES#DISABLE_ALL_ROUTER" value="false"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.MCU_PADCFG_0.MCU_DW_APB_UART_WRAP0_router_uart.#SCML_PROPERTIES#disable_router" value="false"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.UART.DW_UART_PHY_0.#SCML_PROPERTIES#EN_UART_TX_LOG_TO_FILE" value="logs.txt"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.UART.DW_UART_PHY_0.#SCML_PROPERTIES#TerminalAutoOpen" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Security.ROT.M55_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/variant" value="AFM_M55"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Security.ROT.M55_SS.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{../../software/bootcode_M55_without_PSC_dependency/vs/stdout/bootcode.axf,,,image+symbols,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.Peripherals.MAIN_PSC_0.#SCML_PROPERTIES#DEPENDENCY_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.Peripherals.MAIN_PSC_1.#SCML_PROPERTIES#DEPENDENCY_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Security.SEC_PSC_0.#SCML_PROPERTIES#DEPENDENCY_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.MCU_PSC_0.#SCML_PROPERTIES#DEPENDENCY_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.MCU_PSC_1.#SCML_PROPERTIES#DEPENDENCY_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.Analytics_cluster.RTI_Timer.RTI_Timer_C7X_0.#SCML_PROPERTIES#PRIV_CHECK_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/bl31.elf,,,symbols,} {$(PSDK_OUT)/u-boot-spl,,,symbols,} {$(PSDK_OUT)/u-boot,,,symbols,} {$(PSDK_OUT)/vmlinux,,,symbols,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu0/arch_timer_freq" value="500000000"/>
