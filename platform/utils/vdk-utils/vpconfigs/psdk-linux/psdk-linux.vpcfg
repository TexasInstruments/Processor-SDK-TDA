  <simProbesThreads name="t1" script="${vpconfigDir}/scripts/board-support/linux_rproc_boot.py" args="'/TDA5_System/TDA5_SoC/MCU_Domain/Periphs/UART/DW_UART_PHY_0'"/>
  <simulationScripts script="${vpconfigDir}/scripts/optional/common_config.py" id="STARTUP_9c8ed29d-1bc6-4f0f-bc3e-23e1d2844987"/>
