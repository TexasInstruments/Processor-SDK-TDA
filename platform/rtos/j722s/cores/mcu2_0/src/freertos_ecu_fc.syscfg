mpu_armv711.$name        = "TIOVX_OBJ_DESC_MEM";
mpu_armv711.attributes   = "NonCached";

mpu_armv712.baseAddr     = 0xA7800000;
mpu_armv712.size         = 22;
mpu_armv712.allowExecute = false;
mpu_armv712.$name        = "APP_FILEIO_MEM";
