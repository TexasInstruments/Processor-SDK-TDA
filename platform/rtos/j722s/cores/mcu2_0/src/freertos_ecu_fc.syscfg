mpu_armv714.baseAddr     = 0xB7800000;
mpu_armv714.size         = 22;
mpu_armv714.allowExecute = false;
mpu_armv714.$name        = "DDR_MCU2_0_VISS_CONFIG_HEAP";
mpu_armv714.attributes   = "CUSTOM";
mpu_armv714.tex          = 7;
mpu_armv714.isBufferable = false;
