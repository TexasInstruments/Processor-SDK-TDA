<?xml version="1.0" encoding="ASCII"?>
<com.synopsys.vp.base.vpcfg.core:Configuration xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:com.synopsys.vp.base.vpcfg.core="com.synopsys.vp.base.vpcfg.core.model" simDir="" simExe="" simArgs="--cwr_wait --snps_vp_profile" simulationStartupScript="" unevaledParamFileVDKC="" unevaledParamFilePCT="" description="This VP Configuration boots TI Linux BSP (Board Support Package). This constitutes of  U-Boot tiU25.01, Kernel tiL6.12, Rootfs from Yocto scarthgap. This configuration works with R9.1.0 TDA5_System FixedVDK release" vpScript="${lib:SNPS_ARMSP_SCRIPTS_LIBRARY}/armsp/vpx_shared/vpscript.py" clearVPScriptInterp="false" comment="gen_tool_VDK-C" simulationScriptReferences="STARTUP_9c8ed29d-1bc6-4f0f-bc3e-23e1d2844987&#xA;BEGIN_OF_SIMULATION_a067d63e-03b0-43ad-a76d-efafa55682dc&#xA;BEGIN_OF_SIMULATION_bf80b3ed-d5e4-48a3-920d-ce5396df303e&#xA;BEGIN_OF_SIMULATION_ef1ac1d1-23ec-4c0a-a732-d9c92daf89a1&#xA;">
  <environmentVariables name="FASTSIM_FASTRAM" defaultValue="0"/>
  <environmentVariables name="IMG_GPU_LIB_PATH" defaultValue="$(vpconfigDir)/../shared/devices/gpu_72.3.408.1039.so"/>
  <environmentVariables name="LINUX_RPROC_BOOT" defaultValue="1"/>
  <environmentVariables name="BOOTMODE" defaultValue="RAM"/>
  <debugInfo traceSimOutput="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#BACKEND_LIBRARY" value="$(PSDK_OUT)/libtivision_apps.so"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#CPUID_BITMASK" value="0x42"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#ENABLE_C7xHostEmulation" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.CpuHostExt.#SCML_PROPERTIES#SYMBOL_FILE" value="$(PSDK_OUT)/vx_app_rtos_linux_c7x_1.out"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.DM_MSRAM.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/u-boot-m55-spl.bin,,,image,} {$(PSDK_OUT)/lpddr5-firmware.bin,0x2a000,,image,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.M55_SS.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/u-boot-m55-spl,,,symbols,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.DM.M55_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/variant" value="AFM_M55"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.GTC.GTC_0.#SCML_PROPERTIES#GTC_DEFAULT_ENABLE" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.GTC.GTC_1.#SCML_PROPERTIES#GTC_DEFAULT_ENABLE" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.MCU_PADCFG_0.#EXTRA_PROPERTIES#DISABLE_ALL_ROUTER" value="false"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.MCU_PADCFG_0.MCU_DW_APB_UART_WRAP0_router_uart.#SCML_PROPERTIES#disable_router" value="false"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.UART.DW_UART_PHY_0.#SCML_PROPERTIES#EN_UART_TX_LOG_TO_FILE" value="logs.txt"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Periphs.UART.DW_UART_PHY_0.#SCML_PROPERTIES#TerminalAutoOpen" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Security.ROT.M55_SS.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{../../software/bootcode_M55/vs/stdout/bootcode.axf,,,image+symbols,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.MCU_Domain.Security.ROT.M55_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/variant" value="AFM_M55"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.Analytics_cluster.RTI_Timer.RTI_Timer_C7X_0.#SCML_PROPERTIES#PRIV_CHECK_BYPASS" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/u-boot-spl,,,symbols,} {$(PSDK_OUT)/u-boot,,,symbols,} {$(PSDK_OUT)/vmlinux,,,symbols,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu0/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu1/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu2/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu3/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu4/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu5/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu6/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/initialize/cpu7/RVBARADDR" value="0x23d80000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu0/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu1/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu2/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu3/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu4/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu5/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu6/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/ocx/Config/cpu7/arch_timer_freq" value="500000000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.CCC.A720_SS.CLUSTER_0.#EXTRA_PROPERTIES#/sws/variant" value="OCX_A720AE"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DDR_0.#EXTRA_PROPERTIES#/ImageInfo/initial_image" value="{$(PSDK_OUT)/tispl.bin,0x00080000,,image,} {$(PSDK_OUT)/u-boot.img,0x01000000,,image,} {$(PSDK_OUT)/Image,0x02000000,,image,} {$(PSDK_OUT)/k3-tda54-vdk.dtb,0x08000000,,image,} {$(PSDK_OUT)/k3-tda54-vdk-vision-apps.dtbo,0x09000000,,image,} "/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.DSS.DISPC_0.#SCML_PROPERTIES#FRAME_PROCESSING_TIME_IN_US" value="500000"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.Peripherals.IMG_GPU_DXS8.IMG_GPU_DXS8_256.#EXTRA_PROPERTIES#runtime_disabled" value="true"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Main_Domain.Peripherals.IMG_GPU_DXS8.IMG_GPU_DXS8_256.#SCML_PROPERTIES#sim_arguments" value="--simlib $(vpconfigDir)/../shared/devices/gpu_72.2.408.4039.so --watchdog-disable --cconfig=TB_MULTICORE_0 --transif_build_opts CSIM"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Periphs.VIRTIO.#EXTRA_PROPERTIES#/config/image_out" value="$(PSDK_OUT)/rootfs-img.ext4"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Periphs.VIRTIO.#EXTRA_PROPERTIES#/config/image_path" value="$(PSDK_OUT)/rootfs-img.ext4"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Periphs.virtio_net_tlm_0.#SCML_PROPERTIES#SLIRP_PORT_FORWARDING" value="8022=22"/>
  <paramOverrides key="TDA5_System.TDA5_SoC.Periphs.VP9D.#EXTRA_PROPERTIES#/config/root_path" value="$(vpconfigDir)"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_CardCapacity_ReducedConfig" value="_16G"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_CardType" value="SDv3.00"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD4_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_SD_SWITCH_ACMD_WIDE_WIDTH_MSB_ORDER" value="3"/>
  <paramOverrides key="TDA5_System.eMMC_Card.eMMC_SD8_Card.MMCorSDFlashCard.#EXTRA_PROPERTIES#/DWSLL/Param_CardCapacity_ReducedConfig" value="_16G"/>
  <monitorSets name="Default" path="${vpconfigDir}/Default.monitors" chartDisplayScript="">
    <startTrigger type="TIME" value="0"/>
  </monitorSets>
  <simProbesThreads name="t2" script="${vpconfigDir}/scripts/board-support/mini_dm.py" args="" enabled="true"/>
  <simProbesThreads name="t1" script="${vpconfigDir}/scripts/board-support/linux_rproc_boot.py" args="'/TDA5_System/TDA5_SoC/MCU_Domain/Periphs/UART/DW_UART_PHY_0'"/>
  <simulationScripts script="${vpconfigDir}/scripts/optional/common_config.py" id="STARTUP_9c8ed29d-1bc6-4f0f-bc3e-23e1d2844987"/>
  <simulationScripts script="${vpconfigDir}/scripts/optional/restrict_simulation_speed.py" id="BEGIN_OF_SIMULATION_a067d63e-03b0-43ad-a76d-efafa55682dc"/>
  <simulationScripts script="${vpconfigDir}/scripts/optional/enable_oskit.py" id="BEGIN_OF_SIMULATION_bf80b3ed-d5e4-48a3-920d-ce5396df303e"/>
  <simulationScripts script="${vpconfigDir}/scripts/board-support/reload_images_on_reset.py" id="BEGIN_OF_SIMULATION_ef1ac1d1-23ec-4c0a-a732-d9c92daf89a1"/>
</com.synopsys.vp.base.vpcfg.core:Configuration>
